{
	"comment": "Contains the steps required to deploy the Shipment Management scenario",
	"fileVersion": "1.0.2",
	"fileLocation": "https://github.ibm.com/api/v3/repos/dba/IRT-Solution-Scenarios/contents/ShipmentManagement/$(cp4baVersionShort)$/deployment/Enterprise/DeployShipmentManagementScenario.json",
	"requiredToolVersion": ">=1.1.136 <1.2.0",
	"requiredCP4BAVersion": ">=26.0.0 <26.1.0",
	"requiredCP4BAPattern": "Enterprise",
	"actions": [
		{
			"CONTAINER": {
				"comment": "This container wraps all actions to deploy the Shipment Management scenario",
				"enabled": "true",
				"description": "Deploy Scenario Shipment Management",
				"actions": [
					{
						"OCP": {
							"enabled": "true",
							"description": "Grant 'Deployed Decision Manager' role to admin user",
							"subActions": [
								{
									"PLATFORM_USERMGT": {
										"enabled": "true",
										"description": "Update Zen roles for admin user",
										"entities": [
											{
												"action": "update",
												"name": "$$(cp4baAdminUsrLower)$$",
												"roles": [
													"Deployed Decision Manager"
												]
											}
										]
									}
								}
							]
						}
					},
					{
						"ADS": {
							"enabled": "$$(deployPart_ADS)$$",
							"description": "ADS1 - Create and fully configure ADS project 'Approval Plan' including Git, Deploy, & Publish",
							"decisionsPrjDisplayName": "$$(ApprovalPlanDecisionsPrjDisplayName|default=Approval Plan)$$",
							"relativeBasePath": "Automation Decision Services",
							"maxBASQueryRetries": 5,
							"subActions": [
								{
									"DOWNLOADRESOURCES": {
										"enabled": "$$(enableArtifactDownloadFromGit)$$",
										"description": "Download resources required for ADS",
										"name": "Download ADS file",
										"token": "$(gitHubSolutionDownloadToken)$",
										"replaceExistingFiles": true,
										"files": [
											{
												"url": "https://github.ibm.com/api/v3/repos/dba/IRT-Solution-Scenarios/contents/ShipmentManagement/$(cp4baVersionShort)$/Decision/Approval%20Plan.zip"
											}
										]
									}
								},
								{
									"TESTCONNECTION": {
										"comment": "Used when internal gitea is available and no external git server is specified",
										"enabled": "$$(isGiteaAvailable)$$ && $$(ISNOTSET(adsGitServerUrl))$$",
										"description": "Test ADS capability"
									}
								},
								{
									"TESTCONNECTION": {
										"comment": "Used when no internal gitea is available or external git server is specified",
										"enabled": "$$(!isGiteaAvailable)$$ || $$(ISSET(adsGitServerUrl))$$",
										"description": "Test ADS capability",
										"gitServerUrl": "$$(adsGitServerUrl|default=)$$",
										"userName": "$$(adsGitUserName|default=)$$",
										"apiKey": "$$(adsGitRepoAPIKey|default=)$$"
									}
								},
								{
									"CHECKPROJECTISCONNECTEDTOGIT": {
										"comment": "Used when no ADS auto connect to Git is configured and no internal gitea is available or external git server is specified",
										"enabled": "$$(!isADSAutoConnectToGit)$$ && ($$(!isGiteaAvailable)$$ || $$(ISSET(adsGitServerUrl))$$)",
										"description": "Check if ADS decision project already exists and if it is already connected to Git"
									}
								},
								{
									"CREATEGITREPO": {
										"comment": "Used when internal gitea is available, no external git server is specified, and ADS auto connect to Git is not configured",
										"enabled": "$$(isGiteaAvailable)$$ && $$(ISNOTSET(adsGitServerUrl))$$ && $$(!isADSAutoConnectToGit)$$",
										"description": "Create Git org and repo in internal Gitea",
										"orgName": "$$(adsGitOrg)$$",
										"repoName": "$$(adsGitRepoApprovalPlan)$$",
										"repoDescription": "$$(adsGitRepoDescriptionApprovalPlan)$$"
									}
								},
								{
									"CREATEGITREPO": {
										"comment": "Used when no ADS auto connect to Git is configured and no internal gitea is available or external git server is specified",
										"enabled": "$$(!isADSAutoConnectToGit)$$ && ($$(!isGiteaAvailable)$$ || $$(ISSET(adsGitServerUrl))$$) && $$(connectWithGit|default=true)$$",
										"description": "Create Git repo in external Git repository",
										"gitServerUrl": "$$(adsGitServerUrl|default=)$$",
										"userName": "$$(adsGitUserName|default=)$$",
										"apiKey": "$$(adsGitRepoAPIKey|default=)$$",
										"orgName": "$$(adsGitOrg)$$",
										"repoName": "$$(adsGitRepoApprovalPlan)$$",
										"repoDescription": "$$(adsGitRepoDescriptionApprovalPlan)$$"
									}
								},
								{
									"CREATEPROJECT": {
										"enabled": "true",
										"description": "Create ADS project 'Approval Plan' in Studio",
										"name": "Approval Plan2"
									}
								},
								{
									"CONNECTWITHGIT": {
										"comment": "Used when internal gitea is available, no external git server is specified, and ADS auto connect to Git is not configured",
										"enabled": "$$(isGiteaAvailable)$$ && $$(ISNOTSET(adsGitServerUrl))$$ && $$(!isADSAutoConnectToGit)$$",
										"description": "Connect ADS project to internal gitea repository",
										"gitRepoUrl": "!GITREPOURL!",
										"checkConnection": "true",
										"egressNetworkPolicies": [
											"ADSGitServiceEgress_NetworkPolicy.json"
										],
										"tryFixingLocalGiteaCertificateIssue": "true",
										"pollForTrustedCertificateUpdate": "true",
										"pollForTrustedCertificateUpdateMaxTimes": "12",
										"pollForTrustedCertificateUpdatePollDelayInMinutes": "5",
										"restartCP4BAOperator": "true",
										"cp4baOperatorRestartMaxRepeat": "12",
										"cp4baOperatorRestartSleepSeconds": "5"
									}
								},
								{
									"CONNECTWITHGIT": {
										"comment": "Used when no ADS auto connect to Git is configured and no internal gitea is available or external git server is specified",
										"enabled": "$$(!isADSAutoConnectToGit)$$ && ($$(!isGiteaAvailable)$$ || $$(ISSET(adsGitServerUrl))$$) && $$(connectWithGit|default=true)$$",
										"description": "Connect ADS project to external git repository",
										"gitRepoUrl": "!GITREPOURL!",
										"gitApiKey": "$$(adsGitRepoAPIKey|default=)$$"
									}
								},
								{
									"IMPORTDECISIONSERVICES": {
										"enabled": "true",
										"description": "Import 'Approval Plan' decision service",
										"decisionServiceName": "Approval Plan",
										"upgradeIfRequired": true,
										"file": "Approval Plan.zip",
										"maxImportCompletionPolls": 12,
										"delayBetweenImportCompletionPolls": 10
									}
								},
								{
									"COMMITCHANGES": {
										"enabled": "true",
										"description": "Commit changes in ADS project to git",
										"commitMessage": "Initial automatic setup of Approval Plan project",
										"maxCommitCompletionPolls": 20,
										"delayBetweenCommitCompletionPolls": 10
									}
								},
								{
									"VERSIONPROJECT": {
										"enabled": "true",
										"description": "Create a new version of the 'Approval Plan' ADS project",
										"versionDescription": "Initial version of the Approval Plan Decision Solution",
										"version": "1.0.0"
									}
								},
								{
									"DEPLOYPROJECT": {
										"enabled": "true",
										"description": "Deploy the version to the runtime",
										"decisionServiceName": "Approval Plan",
										"version": "1.0.0",
										"maxDeployCompletionPolls": 60,
										"delayBetweenDeployCompletionPolls": 5
									}
								},
								{
									"PUBLISHAUTOMATIONSERVICES": {
										"enabled": "true",
										"description": "Publish the ADS decision service as an automation service",
										"skipRemainingSubactionOnFailure": "false",
										"snapshot": "1.0.0",
										"maxPublishCompletionPolls": "$$(publishAS_maxPublishCompletionPolls)$$",
										"delayBetweenPublishCompletionPolls": "$$(publishAS_delayBetweenPublishCompletionPolls)$$"
									}
								}
							]
						}
					},
					{
						"ADS": {
							"enabled": "$$(deployPart_ADS)$$",
							"description": "ADS2 - Create and fully configure ADS project 'Carrier Risk Automation' including Git, Deploy, & Publish",
							"decisionsPrjDisplayName": "$$(CarrierRiskAutomationDecisionsPrjDisplayName|default=Carrier Risk Automation)$$",
							"relativeBasePath": "Automation Decision Services",
							"maxBASQueryRetries": 5,
							"subActions": [
								{
									"DOWNLOADRESOURCES": {
										"enabled": "$$(enableArtifactDownloadFromGit)$$",
										"description": "Download resources required for ADS",
										"name": "Download ADS file",
										"token": "$(gitHubSolutionDownloadToken)$",
										"replaceExistingFiles": true,
										"files": [
											{
												"url": "https://github.ibm.com/api/v3/repos/dba/IRT-Solution-Scenarios/contents/ShipmentManagement/$(cp4baVersionShort)$/Decision/Carrier%20Delivery%20Risk%20Decision.zip"
											},
											{
												"name": "carrier_delivery_failure_scorecard.pmml",
												"url": "https://github.ibm.com/api/v3/repos/dba/IRT-Solution-Scenarios/contents/ShipmentManagement/$(cp4baVersionShort)$/Documents",
												"retrievalMode": "latest",
												"matchStr": "carrier_delivery_failure_scorecard.*\\.pmml"
											}
										]
									}
								},
								{
									"TESTCONNECTION": {
										"comment": "Used when internal gitea is available and no external git server is specified",
										"enabled": "$$(isGiteaAvailable)$$ && $$(ISNOTSET(adsGitServerUrl))$$",
										"description": "Test ADS capability"
